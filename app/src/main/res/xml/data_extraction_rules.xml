<?xml version="1.0" encoding="utf-8"?>
<!--
  The auth token lives in sharedpref and in a plain file under filesDir. Neither may leave the
  device through backup or device-to-device transfer: a copy sitting in a cloud backup defeats
  the point of a token nobody has to type in by hand.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
